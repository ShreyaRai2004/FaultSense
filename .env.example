# Copy this file to .env and add your own Groq API key.
# Get a key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: base URL for a separately deployed FaultSense FastAPI service.
# Leave blank to use the same local prediction function used by api.py.
# Example: FAULTSENSE_API_URL=https://your-api-service.example.com
FAULTSENSE_API_URL=
